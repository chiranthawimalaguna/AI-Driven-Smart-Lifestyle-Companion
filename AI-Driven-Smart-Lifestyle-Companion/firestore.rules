rules_version = '2';

// Paste this into the Firebase console: Firestore Database -> Rules.
//
// Every document lives under users/{uid}/... - these rules mean a signed-in user
// can only ever read or write documents under their own uid. This is the
// enforcement point for "each user's routines and health data are private," and
// it's checked server-side by Firebase, not just left to client-side logic.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
